<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dash_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dash_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <EditText
            android:id="@+id/dash_txtId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cedula / ID Persona"
            android:inputType="text"
            android:maxLength="15" />

        <EditText
            android:id="@+id/dash_txtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre"
            android:inputType="textPersonName"
            android:maxLength="30" />

        <EditText
            android:id="@+id/dash_txtFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Primer Apellido"
            android:inputType="textPersonName"
            android:maxLength="30" />

        <EditText
            android:id="@+id/dash_txtLastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Segundo Apellido"
            android:inputType="textPersonName"
            android:maxLength="30" />

        <EditText
            android:id="@+id/dash_txtPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Telefono"
            android:inputType="number"
            android:maxLength="8" />

        <EditText
            android:id="@+id/dash_txtEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:maxLength="50" />

        <EditText
            android:id="@+id/dash_txtAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Direccion"
            android:inputType="text"
            android:maxLength="100" />

        <EditText
            android:id="@+id/dash_txtContributionsTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Total Contribuciones"
            android:inputType="numberDecimal"
            android:maxLength="10" />

        <EditText
            android:id="@+id/dash_txtMonth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mes (1-12)"
            android:inputType="number"
            android:maxLength="2" />

        <EditText
            android:id="@+id/dash_txtYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Año (ej. 2025)"
            android:inputType="number"
            android:maxLength="4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/dash_btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/TextSave" />

            <Button
                android:id="@+id/dash_btnDelete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/TextDelete" />

            <Button
                android:id="@+id/dash_btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/TextCancel" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>