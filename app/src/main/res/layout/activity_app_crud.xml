<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_crud_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/app_form_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="@string/app_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/app_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cedula / ID"
            android:inputType="text" />

        <EditText
            android:id="@+id/app_patient_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/app_first_surname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Primer Apellido"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/app_second_surname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Segundo Apellido"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/app_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Telefono"
            android:inputType="phone" />

        <EditText
            android:id="@+id/app_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/app_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Direccion"
            android:inputType="textPostalAddress" />

        <TextView
            android:id="@+id/app_doctor_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:labelFor="@id/app_doctor"
            android:text="Doctor:" />

        <EditText
            android:id="@+id/app_doctor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del Doctor"
            android:inputType="textPersonName" />

        <TextView
            android:id="@+id/app_specialty_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:labelFor="@id/app_specialty"
            android:text="Especialidad:" />

        <Spinner
            android:id="@+id/app_specialty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/app_date_time_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:labelFor="@id/app_date_time"
            android:text="Fecha y Hora (yyyy-MM-dd HH:mm):" />

        <EditText
            android:id="@+id/app_date_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="2025-12-31 14:00"
            android:inputType="datetime" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/app_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/TextSave" />

            <Button
                android:id="@+id/app_delete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/TextDelete" />

            <Button
                android:id="@+id/app_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/TextCancel" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
